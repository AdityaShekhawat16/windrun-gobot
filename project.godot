; WINDRUN — a momentum-driven 3D meadow runner
; Open in Godot 4.7.2 (Godot 4.4+ should also work).
config_version=5

[application]
config/name="WINDRUN — Art Foundation v1.2"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Run with the hills. Fly with the wind."
run/max_fps=120

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.44, 0.76, 0.91, 1)

[physics]
3d/default_gravity=24.0
3d/default_gravity_vector=Vector3(0, -1, 0)

